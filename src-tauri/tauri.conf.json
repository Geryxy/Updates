{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Köd Koronája Launcher",
  "mainBinaryName": "KodKoronajaLauncher",
  "version": "1.0.0",
  "identifier": "hu.kodkoronaja.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Köd Koronája Launcher",
        "url": "launcher.html",
        "width": 980,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Köd Koronája",
    "copyright": "© Köd Koronája",
    "category": "StrategyGame",
    "shortDescription": "Köd Koronája – A birodalmak felemelkedése",
    "longDescription": "Körökre osztott fantasy stratégiai játék: építs királyságot, vezess hadjáratokat és egyesítsd Eldóriát.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Hungarian", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Köd Koronája"
      },
      "wix": { "language": "hu-HU" }
    }
  }
}
